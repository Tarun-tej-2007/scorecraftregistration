# ══════════════════════════════════════════════════════════
# SCORECRAFT — Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ─────────────────────────────────────────────────────────
# PAYMENT MODE
# ─────────────────────────────────────────────────────────
# Set to "demo" for local development / testing.
# Set to "razorpay" for production (requires keys below).

PAYMENT_MODE=demo
NEXT_PUBLIC_PAYMENT_MODE=demo

# ─────────────────────────────────────────────────────────
# RAZORPAY (production only)
# ─────────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Key Secret is NEVER exposed to the client.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# NEXT_PUBLIC_ prefix makes this available in the browser
# (used to initialise Razorpay checkout on the client).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────────────────
# DATABASE (production only — replace in-memory store)
# ─────────────────────────────────────────────────────────
DATABASE_URL=
