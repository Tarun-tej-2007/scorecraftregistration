# ══════════════════════════════════════════════════════════
# SCORECRAFT — Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────────────────
# MONGODB (required)
# ─────────────────────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Example: mongodb+srv://scorecraft:mypassword@cluster0.abcde.mongodb.net/scorecraft

MONGODB_URI=

# ─────────────────────────────────────────────────────────
# ADMIN PASSWORD (required)
# ─────────────────────────────────────────────────────────
# The password used to log in to the /admin dashboard.
# Choose a strong password. This is checked server-side
# and is NEVER exposed to the browser.

ADMIN_SECRET=

# ─────────────────────────────────────────────────────────
# PAYMENT MODE (optional — defaults to upi_qr)
# ─────────────────────────────────────────────────────────
# Payment is now via UPI QR code.
# These Razorpay keys are kept for future reference only.

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
